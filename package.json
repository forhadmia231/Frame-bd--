{
  "name": "frame-bd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:routes": "node scripts/smoke-routes.mjs",
    "db:status": "prisma migrate status --config prisma.config.ts",
    "db:check": "node scripts/check-migrations.mjs",
    "db:maintenance": "tsx scripts/maintenance.ts",
    "mail:dev": "node scripts/local-mail.mjs",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "predev": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:restrict": "node scripts/restrict-local-database.mjs",
    "db:seed:demo": "node --conditions=react-server --import tsx prisma/seed.ts --demo",
    "pretypecheck": "prisma generate --config prisma.config.ts",
    "test:backend": "node --conditions=react-server --import dotenv/config --import tsx --test tests/backend.test.ts",
    "test:admin": "node --conditions=react-server --import dotenv/config --import tsx --test tests/admin.test.ts",
    "worker:stream": "node --conditions=react-server --import tsx scripts/stream-worker.ts",
    "stream:demo": "node --conditions=react-server --import tsx scripts/stream-demo.ts",
    "test:streaming": "node --conditions=react-server --import dotenv/config --import tsx --test tests/streaming.test.ts",
    "db:start": "node scripts/local-database.mjs start",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "prebuild": "prisma generate --config prisma.config.ts",
    "db:stop": "node scripts/local-database.mjs stop",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.18",
    "dotenv": "^18.0.9",
    "hls.js": "^1.7.4",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "ffmpeg-static": "^5.3.0",
    "prisma": "^7.10.1",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
