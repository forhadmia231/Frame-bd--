# Server-only. Never prefix credentials with NEXT_PUBLIC_.
# db:start generates private local values without overwriting an existing .env.
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_REGION=BD
# Enable only behind a trusted reverse proxy that overwrites x-real-ip.
TRUST_PROXY=false
# Local development inbox; no internet delivery. External SMTP requires TLS.
EMAIL_DELIVERY_MODE=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Frame BD <no-reply@framebd.local>
# Optional: verified Stripe webhooks only. Checkout remains disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional R2/S3 private bucket: admin images/subtitles and signed video uploads.
# Leave blank for loopback-only local image/subtitle storage. Use HTTPS endpoint.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional independent random signing secret; otherwise derived from BETTER_AUTH_SECRET.
PLAYBACK_SIGNING_SECRET=
# Explicit loopback-only private storage for development. Never enable remotely.
STREAM_LOCAL_STORAGE=false
# Production workers require maintained binaries at absolute paths.
FFMPEG_PATH=
FFPROBE_PATH=
TRANSCODE_WORK_DIR=.local/transcode
TRANSCODE_TIMEOUT_SECONDS=10800
STREAM_THUMBNAILS=false
